<header class="main-header">
  <nav class="main-header__nav">
    <ul class="main-header__item-list">
      <li class="main-header__item">
        <a class="<%= path === '/' ? 'active' : '' %>" href="/">Shop</a>
      </li>
      <li class="main-header__item">
        <a class="<%= path === '/products' ? 'active' : '' %>" href="/products"
          >Products</a
        >
      </li>
      <li class="main-header__item">
        <a class="<%= path === '/orders' ? 'active' : '' %>" href="/orders"
          >Orders</a
        >
      </li>
      <li class="main-header__item">
        <a
          class="disabled-link <%= path === '/cart' ? 'active' : '' %>"
          href="/cart"
          aria-disabled="true"
          >Cart</a
        >
      </li>
      <li class="main-header__item">
        <a
          class="disabled-link <%= path === '/checkout' ? 'active' : '' %>"
          href="/checkout"
          aria-disabled="true"
          >Checkout</a
        >
      </li>
      <li class="main-header__item">
        <a
          class="<%= path === '/admin/add-product' ? 'active' : ''%>"
          href="/admin/add-product"
          >Add Product</a
        >
      </li>
      <li class="main-header__item">
        <a
          class="<%= path === '/admin/products' ? 'active' : ''%>"
          href="/admin/products"
          >Admin products</a
        >
      </li>
      <% if (isLoggedIn) { %>
      <li class="main-header__item">
        <form action="/logout" method="POST">
          <button class="btn" type="submit">Logout</button>
        </form>
      </li>
      <% } else { %>
      <li class="main-header__item">
        <a class="<%= path === '/login' ? 'active' : '' %>" href="/login"
          >Login</a
        >
      </li>
      <li class="main-header__item">
        <a class="<%= path === '/signup' ? 'active' : '' %>" href="/signup"
          >Signup</a
        >
      </li>
      <% } %>
    </ul>
  </nav>
</header>
